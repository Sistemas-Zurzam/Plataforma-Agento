# Copia este archivo a ".env" (desarrollo local) o ".env.production" (build de
# producción) y ajusta los valores. Nunca commitees ".env" ni ".env.production"
# reales — solo este ejemplo.
#
# Vite solo expone al navegador las variables que empiezan con VITE_ — y las
# "hornea" dentro del JS en el momento de `npm run build`, no en tiempo de
# ejecución. Si despliegas el mismo build a dos ambientes sin recompilar,
# ambos usarán la URL con la que se compiló. Nunca pongas secretos acá: todo
# lo que empiece con VITE_ queda visible en el bundle final, legible por
# cualquiera que abra las DevTools del navegador.

# URL base de la API de Laravel, incluyendo el prefijo /api.
# En producción, Apache publica frontend y API bajo agento.com.pe, por lo que
# una ruta relativa evita CORS, contenido mixto y dependencias de una IP.
VITE_API_URL=/api

# Si el frontend local consume directamente el servidor de Laravel, usa:
# VITE_API_URL=http://127.0.0.1:8000/api
